{
  "manifest_version": 3,
  "name": "REPEAT Observer",
  "version": "1.1.0",
  "description": "Turns high-level browser interactions into semantic workflow events for REPEAT. Never captures passwords, payment fields or keystrokes.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:3000/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js", "sites/gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.clickup.com/*"],
      "js": ["content.js", "sites/clickup.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.atlassian.net/*"],
      "exclude_matches": ["https://id.atlassian.net/*", "https://*.atlassian.net/login*"],
      "js": ["content.js", "sites/jira.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "REPEAT Observer",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
