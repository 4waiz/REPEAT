# ---------------------------------------------------------------------------
# REPEAT — environment
# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With no .env file at all, REPEAT runs in
# fully deterministic Demo Mode with zero network calls.
# ---------------------------------------------------------------------------

# Demo Mode. "true" (default) = deterministic local engine, no external calls.
# "false" = allow the optional live integrations below when their keys exist.
DEMO_MODE=true

# --- Optional: model understanding via OpenRouter ---------------------------
# When present AND DEMO_MODE=false, REPEAT reads each new report with a model
# through OpenRouter (https://openrouter.ai/keys). Output is Zod-validated and
# every cited piece of evidence must be a literal quote from the report; any
# failure falls back to the deterministic classifier, so the demo cannot break.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Fast, cheap models that emit JSON reliably are best.
OPENROUTER_MODEL=openai/gpt-4.1-mini
# Comma-separated models OpenRouter may route to if the primary is unavailable.
OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-4.5
# Attribution shown on openrouter.ai for this app's traffic.
OPENROUTER_SITE_URL=https://github.com/4waiz/REPEAT

# --- Optional: OpenAI directly, instead of OpenRouter -----------------------
# Same wire format. Used only when OPENROUTER_API_KEY is empty. Needs a real
# API key from platform.openai.com (Codex credits are not API credits).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Optional: Gemini directly, instead of OpenRouter -----------------------
# Google's OpenAI-compatible endpoint. Used when the two keys above are empty.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Optional: related-context research via Exa -----------------------------
# When present AND DEMO_MODE=false, REPEAT searches Exa (https://dashboard.exa.ai)
# for public pages related to the symptom and attaches them to the Ghost Run
# and the ticket. Only the symptom phrase is sent — never the sender, their
# address, or the message body. Verify with: npm run verify:live
EXA_API_KEY=

# --- Optional: real ticket creation in ClickUp ------------------------------
# When present AND DEMO_MODE=false, the "Create issue" and "Assign owner"
# steps of an approved run create and assign a real task in this list.
# Personal token from ClickUp settings -> Apps; list id from the list URL.
CLICKUP_API_KEY=
CLICKUP_LIST_ID=
# Optional: restrict member lookup to one workspace id.
CLICKUP_TEAM_ID=
# Owner name -> ClickUp user id, for owners whose ClickUp username does not
# start with their first name. e.g. Noor=123456,Umar=234567
CLICKUP_ASSIGNEES=

# --- Live mode: CopilotKit runtime (no key needed) --------------------------
# When DEMO_MODE=false the Ghost Run is streamed over AG-UI through a
# self-hosted CopilotKit runtime at /api/copilotkit. Nothing to configure;
# this only switches off CopilotKit's anonymous telemetry.
COPILOTKIT_TELEMETRY_DISABLED=true

# --- Optional: the real inbox (Gmail over IMAP) -----------------------------
# When present AND DEMO_MODE=false, the Mail window is this Gmail inbox and a
# new unread support report there fires the trigger. Needs a Google app
# password: 2-Step Verification on, then https://myaccount.google.com/apppasswords
# (the Gmail REST API refuses plain API keys for mailbox access).
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Optional Gmail search filter, e.g. label:support or to:support@yourdomain.com
GMAIL_QUERY=

# --- Optional: real ticket creation in Jira Cloud ---------------------------
# Used when ClickUp is not set, or when TRACKER=jira. Token from
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# Issue type name in that project (Bug, Task, ...).
JIRA_ISSUE_TYPE=Bug
# Owner name -> Jira accountId, for owners whose display name does not start
# with their first name. e.g. Noor=5b10ac8d82e05b22cc7d4ef5
JIRA_ASSIGNEES=

# --- Optional: tickets in Ambiguous AI --------------------------------------
# Sandbox: credential-free, disposable, synthetic task board (one-hour
# sessions, tasks only). Used when no other tracker is configured, or when
# TRACKER=ambiguous. Verify with: npm run verify:ambiguous
AMBIGUOUS_SANDBOX=true
# Workspace: a real Ambiguous workspace. `npx ambiguous auth signup` prints an
# ak_ key; the channel id enables the team notification there.
AMBIGUOUS_API_KEY=
AMBIGUOUS_BASE_URL=https://app.ambiguous.ai
AMBIGUOUS_CHANNEL_ID=
# Force one tracker for a demo: clickup | ambiguous | github. Otherwise the
# first configured of ClickUp, Ambiguous workspace, GitHub, Ambiguous sandbox.
TRACKER=

# --- Optional: real GitHub issue creation (used when ClickUp is not set) ----
# Needs a fine-grained PAT with Issues: read & write on the target repo.
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo

# --- Optional: real Slack notification --------------------------------------
SLACK_WEBHOOK_URL=
