# ---------------------------------------------------------------------------
# REPEAT — environment
# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. With no .env file at all, REPEAT runs in
# fully deterministic Demo Mode with zero network calls.
# ---------------------------------------------------------------------------

# Demo Mode. "true" (default) = deterministic local engine, no external calls.
# "false" = allow the optional live adapters below when their keys exist.
DEMO_MODE=true

# --- Optional: LLM semantic understanding -----------------------------------
# When present AND DEMO_MODE=false, /api/understand uses Claude to extract and
# classify the bug report. Output is Zod-validated; any failure falls back to
# the deterministic classifier, so the demo cannot break.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Optional: real GitHub issue creation -----------------------------------
# Needs a fine-grained PAT with Issues: read & write on the target repo.
GITHUB_TOKEN=
GITHUB_REPO=your-org/your-repo

# --- Optional: real Slack notification --------------------------------------
SLACK_WEBHOOK_URL=
