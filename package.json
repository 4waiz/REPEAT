{
  "name": "repeat",
  "version": "1.0.0",
  "private": true,
  "description": "REPEAT — Show it once. Never do it again. An AI layer that learns repetitive workflows by watching how you already work.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/next-prod.mjs build",
    "start": "node scripts/next-prod.mjs start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/verify-engine.ts",
    "verify:live": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/verify-live.ts",
    "verify:ambiguous": "node --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/verify-ambiguous.ts",
    "verify:copilotkit": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings --import ./scripts/alias-loader.mjs scripts/verify-copilotkit.ts",
    "check": "npm run typecheck && npm run verify && npm run lint"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@copilotkit/react-core": "^1.71.1",
    "@copilotkit/runtime": "^1.71.1",
    "@xyflow/react": "^12.11.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "imapflow": "^2.0.2",
    "lucide-react": "^1.45.0",
    "mailparser": "^3.9.25",
    "next": "^15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^2.6.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.5.6",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.25",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
